# Minimum runtime
POSTGRES_URL=
BETTER_AUTH_SECRET=

# Monstro Admin session handoff (required for sign-in)
MONSTRO_AUTH_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
MONSTRO_AGENT_SSO_SECRET=

# Billing owner's server-side Vercel token (project discovery and previews)
VERCEL_ACCESS_TOKEN=

# Shared GitHub App installation (required for repo access, pushes, and PRs)
# Install the app only on the Monstro repositories editors may access.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_ACCOUNT_LOGIN=

# Optional GitHub account linking and installation lifecycle UI/webhooks
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=

# Optional Redis / Vercel KV (skills metadata cache; falls back to in-memory when not set)
REDIS_URL=
KV_URL=

# Optional deployment refinements
# Set to "hobby" to use lower resource defaults for constrained deployments.
# Leave unset for standard behavior.
OPEN_AGENTS_RESOURCE_PROFILE=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# Optional base snapshot for fresh sandboxes. If unset, sandboxes use Vercel's standard Sandbox runtime.
# Use a snapshot created in/accessible to your own Vercel scope.
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
